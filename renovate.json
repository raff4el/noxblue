{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "description": "Track the secureblue base image tag in recipe.yml",
      "customType": "regex",
      "managerFilePatterns": ["/^recipes/.+\\.ya?ml$/"],
      "matchStrings": [
        "base-image:\\s*(?<depName>\\S+)[\\s\\S]*?image-version:\\s*(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "description": "Flag the hardcoded Terra release so it gets bumped alongside image-version",
      "customType": "regex",
      "managerFilePatterns": ["/^files/dnf/.+\\.repo$/"],
      "matchStrings": ["repos\\.fyralabs\\.com/terra(?<currentValue>\\d+)"],
      "depNameTemplate": "fedora",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}
